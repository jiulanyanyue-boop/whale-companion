+++ b/astrbot/core/agent/tool_discovery.py
@@ -0,0 +1,110 @@
+"""Request-scoped discovery over an already authorized tool set."""
+
+import json
+import re
+from dataclasses import field
+from typing import Any
+
+from pydantic.dataclasses import dataclass
+
+from .tool import FunctionTool, ToolSet
+
+
+@dataclass
+class DiscoverTools(FunctionTool):
+    catalog: Any = field(default_factory=dict, repr=False)
+    visible: Any = field(default=None, repr=False)
+    name: str = "astrbot_discover_tools"
+    description: str = (
+        "Find and load tools before using capabilities that are not currently listed. "
+        "Search by task, service, or exact tool name; full schemas become available "
+        "on the next step. Search does not execute the discovered tools."
+    )
+    parameters: dict = field(
+        default_factory=lambda: {
+            "type": "object",
+            "properties": {
+                "query": {
+                    "type": "string",
+                    "description": "Task, service or tool name.",
+                },
+                "names": {"type": "array", "items": {"type": "string"}, "maxItems": 4},
+            },
+            "required": ["query"],
+        }
+    )
+
+    async def call(self, context, query: str, names: list[str] | None = None):
+        """Load matching tools from this request's permission-filtered catalog.
+
+        Args:
+            context: Execution context, unused for permission expansion.
+            query: Free text or exact tool name.
+            names: Optional exact tool names, at most four.
+
+        Returns:
+            Names loaded for the next step, or a bounded discovery hint.
+        """
+        if not isinstance(query, str) or len(query) > 1000:
+            return json.dumps({"error": "invalid_query"})
+        if names is not None and (
+            not isinstance(names, list)
+            or len(names) > 4
+            or any(not isinstance(name, str) for name in names)
+        ):
+            return json.dumps({"error": "invalid_names"})
+        terms = set(re.findall(r"[a-z0-9]+|[\u4e00-\u9fff]{2}", query.lower()))
+        exact_names = set(names or []) or {
+            name for name in self.catalog if name.lower() in query.lower()
+        }
+        ranked = []
+        for name, tool in self.catalog.items():
+            if not tool.active or (exact_names and name not in exact_names):
+                continue
+            haystack = (name + " " + tool.description).lower()
+            score = sum(1 for term in terms if term in haystack)
+            if name in (names or []) or name.lower() in query.lower():
+                score += 1000
+            if score:
+                ranked.append((-score, name, tool))
+        ranked.sort(key=lambda item: (item[0], item[1]))
+        loaded = []
+        for _, name, tool in ranked[:4]:
+            self.visible.add_tool(tool)
+            loaded.append(name)
+        return json.dumps(
+            {
+                "loaded": loaded,
+                "instruction": "Use the newly available schemas on the next step; normal permissions still apply.",
+                "available_names": list(self.catalog)[:24] if not loaded else [],
+            },
+            ensure_ascii=False,
+        )
+
+
+def defer_tool_schemas(tools: ToolSet) -> ToolSet:
+    """Expose a small index while preserving authorized handlers for discovery.
+
+    Args:
+        tools: Tools after persona, plugin and permission filtering.
+
+    Returns:
+        A new request-local tool set; the shared registry is never changed.
+    """
+    catalog = {tool.name: tool for tool in tools.tools if tool.active}
+    visible = ToolSet()
+    discovery = DiscoverTools(catalog=catalog, visible=visible)
+    # A bounded metadata index helps small catalogs and multilingual requests.
+    index = "\n".join(
+        f"{name}: {tool.description.splitlines()[0][:100]}"
+        for name, tool in list(catalog.items())[:24]
+        if tool.description
+    )
+    if index:
+        discovery.description += "\nAvailable capabilities (partial index):\n" + index
+    visible.add_tool(discovery)
+    # The existing overflow mechanism must retain its read capability.
+    reader = catalog.get("astrbot_file_read_tool")
+    if reader is not None:
+        visible.add_tool(reader)
+    return visible
